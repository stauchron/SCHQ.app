# Kopieer dit bestand naar `.env.local` en vul de waardes in.
# Beide vind je in Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Voor de AI foto-analyse (Claude Vision).
